# SPACE SENTINEL Environment Configuration Example
# Copy to .env for local development or set in production deployment

# Application Settings
APP_NAME=SPACE SENTINEL
APP_ENV=production
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=*

# Database (Default: SQLite; Production: PostgreSQL)
DATABASE_URL=sqlite:///./data/orbitguard.db

# Orbital Data Ingestion Settings
ORBITAL_DATA_PROVIDER=CelesTrak
SYNC_INTERVAL_MINUTES=30

# Optional USSPACECOM Space-Track Credentials (Backend Only)
# SPACETRACK_USER=your_user@domain.com
# SPACETRACK_PASSWORD=your_password

# Conjunction Screening Engine Configuration
DEFAULT_PREDICTION_WINDOW_HOURS=24
PROPAGATION_STEP_MINUTES=5
CONJUNCTION_THRESHOLD_KM=500.0
CONJUNCTION_SCREENING_DISTANCE_KM=50.0
CRITICAL_THRESHOLD_KM=5.0
HIGH_THRESHOLD_KM=15.0
MEDIUM_THRESHOLD_KM=30.0
