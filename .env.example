# ORBITGUARD Environment Configuration Example
# Copy to .env for local development or set in production deployment

# Application Settings
APP_NAME=ORBITGUARD
APP_ENV=production
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (Default: SQLite; Production: Supabase/PostgreSQL)
DATABASE_URL=sqlite:///./data/orbitguard.db
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Orbital Data Provider & CelesTrak Configuration
ORBITAL_DATA_PROVIDER=CelesTrak
CELESTRAK_ACTIVE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=tle
CELESTRAK_STATIONS_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=tle
CELESTRAK_DEBRIS_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=1982-092&FORMAT=tle
LOCAL_TLE_FALLBACK=./data/cache/celestrak_sample.tle

# Orbital Propagation & Conjunction Screening Engine
DEFAULT_PREDICTION_WINDOW_HOURS=24
PROPAGATION_STEP_MINUTES=5
CONJUNCTION_SCREENING_DISTANCE_KM=50.0
CONJUNCTION_THRESHOLD_KM=50.0
CRITICAL_THRESHOLD_KM=5.0
HIGH_THRESHOLD_KM=15.0
MEDIUM_THRESHOLD_KM=30.0
