# SPACE SENTINEL — Environment Configuration

APP_NAME=SPACE SENTINEL
APP_ENV=production
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./data/orbitguard.db

# Space-Track.org Official Credentials (Primary Data Provider)
# Register free at https://www.space-track.org/auth/createAccount
SPACE_TRACK_USERNAME=
SPACE_TRACK_PASSWORD=

# Sync interval (minutes) - Space-Track allows max 1 bulk request/hour
SYNC_INTERVAL_MINUTES=60

# Screening Parameters
DEFAULT_PREDICTION_WINDOW_HOURS=24
PROPAGATION_STEP_MINUTES=5
CONJUNCTION_THRESHOLD_KM=50.0
CRITICAL_THRESHOLD_KM=5.0
HIGH_THRESHOLD_KM=15.0
MEDIUM_THRESHOLD_KM=30.0
